# Teammate's earlier work: read-only reference, never part of our build
reference/

# Dependencies
node_modules/
.pnpm-store/

# Build output
extension/.output/
extension/.wxt/
dist/
build/

# onnxruntime-web's WASM binary: 27 MB, and byte-identical to what npm installs.
# `npm run assets` (also run on postinstall) copies it back from node_modules.
# The 227 KB YuNet model in public/models/ IS committed, so a fresh clone can run
# the demo with no network.
extension/public/ort/

# Python
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/

# ML artifacts (large; regenerate with the scripts in ml/)
ml/data/
ml/runs/
*.pt
*.onnx.bak

# Secrets and local config
.env
.env.*
!.env.example

# Eval output
eval/results/

# Per-user Claude Code settings (launch.json is shared and stays tracked)
.claude/settings.local.json

# OS / editor
.DS_Store
*.swp
.idea/
.vscode/

# uv virtualenv
server/.venv/

# Tesseract core WASM: 6.4 MB, copied from node_modules by `npm run assets`.
# eng.traineddata.gz IS committed so a fresh clone runs offline.
extension/public/tesseract/tesseract-core-*
extension/public/tesseract/worker.min.js
