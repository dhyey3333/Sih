# Copy to .env and fill in. .env is gitignored.
#
# Any OpenAI-compatible endpoint serving an open-weights VLM works. Leave
# VLM_BASE_URL empty and the server uses its deterministic rule-based planner
# instead — the whole loop, and every test, runs offline with no key.

# --- vLLM on a GPU box (the offline-deployable story) ---
# VLM_BASE_URL=http://localhost:8001/v1
# VLM_MODEL=Qwen/Qwen3-VL-8B-Instruct
# VLM_API_KEY=not-needed

# --- Ollama on a laptop (no internet at demo time) ---
# `ollama pull qwen2.5vl:3b` (3.2 GB; fits an 8 GB machine beside a browser). With
# 16 GB or more, qwen2.5vl:7b reads small text in screenshots noticeably better.
# VLM_BASE_URL=http://localhost:11434/v1
# VLM_MODEL=qwen2.5vl:3b
# VLM_API_KEY=ollama
# Measured on an 8 GB M1: ~9 s a step with the screenshot, 2-6 s without, and a
# 2-minute cold load. Load it before the demo: `ollama run qwen2.5vl:3b ""`, and
# set OLLAMA_KEEP_ALIVE=30m for the ollama process so it is not unloaded mid-demo.

# --- A hosted open-weights endpoint (SIH allows this) ---
# VLM_BASE_URL=https://openrouter.ai/api/v1
# VLM_MODEL=qwen/qwen3-vl-8b-instruct
# VLM_API_KEY=sk-...

# Seconds to wait for the VLM before falling back to the rule-based planner.
VLM_TIMEOUT=45

# Where the model is spent (docs/DECISIONS.md D28).
#   VLM_STRATEGY=vlm-first    the model decides every step the device did not handle
#   VLM_STRATEGY=rules-first  rules take the steps they are certain of; the model the rest
#   VLM_IMAGE=always          attach the redacted screenshot every step (default)
#   VLM_IMAGE=auto            only when the page has something the DOM cannot describe
#   VLM_IMAGE=never           text only
# On a laptop-class local model, rules-first + auto is the practical setting.
# VLM_STRATEGY=rules-first
# VLM_IMAGE=auto

# Room for the answer. A "thinking" model spends its budget reasoning first; if it
# returns empty answers, raise this or turn thinking off with VLM_EXTRA_BODY, e.g.
#   OpenRouter:   VLM_EXTRA_BODY={"reasoning": {"enabled": false}}
#   vLLM/SGLang:  VLM_EXTRA_BODY={"chat_template_kwargs": {"enable_thinking": false}}
# VLM_MAX_TOKENS=1024
# Set to 0 if the provider rejects response_format (it is retried without it anyway).
# VLM_JSON_MODE=1

# Where the extension is allowed to call from. The extension's origin is
# chrome-extension://<id>, which varies per install, so "*" is the practical
# setting for a local dev server. Tighten it for anything long-lived.
ALLOWED_ORIGINS=*
