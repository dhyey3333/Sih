# Copy to .env and fill in. .env is gitignored.
#
# Any OpenAI-compatible endpoint serving an open-weights VLM works. Leave
# VLM_BASE_URL empty and the server uses its deterministic rule-based planner
# instead — the whole loop, and every test, runs offline with no key.

# --- vLLM on a GPU box (the offline-deployable story) ---
# VLM_BASE_URL=http://localhost:8001/v1
# VLM_MODEL=Qwen/Qwen3-VL-8B-Instruct
# VLM_API_KEY=not-needed

# --- Ollama on a laptop (no internet at demo time) ---
# VLM_BASE_URL=http://localhost:11434/v1
# VLM_MODEL=qwen2.5vl:7b
# VLM_API_KEY=ollama

# --- A hosted open-weights endpoint (SIH allows this) ---
# VLM_BASE_URL=https://openrouter.ai/api/v1
# VLM_MODEL=qwen/qwen3-vl-8b-instruct
# VLM_API_KEY=sk-...

# Seconds to wait for the VLM before falling back to the rule-based planner.
VLM_TIMEOUT=45

# Where the extension is allowed to call from. The extension's origin is
# chrome-extension://<id>, which varies per install, so "*" is the practical
# setting for a local dev server. Tighten it for anything long-lived.
ALLOWED_ORIGINS=*
